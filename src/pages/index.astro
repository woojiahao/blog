---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { FaGithub, FaLinkedin, FaTwitter, FaAt, FaHouse, FaX, FaXTwitter, FaTelegram } from "react-icons/fa6";
import ArticleRow from '../components/ArticleRow.astro';
import RssButton from '../components/RssButton.astro';
import HorizontalRuler from '../components/HorizontalRuler.astro';
import ShortWidget from '../components/ShortWidget.astro';

const latestArticles = (await getCollection("blog", ({data}) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 10)
const latestShort = (await getCollection("shorts", (short) => !short.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).at(0)
---

<Layout>
  <div class="mb-8 flex lg:flex-row flex-col space-between gap-24">
    <div class="flex-1/2">
      <h1 class="!text-6xl !mb-1">Hello, I'm Jiahao!</h1>
      <p class="text-neutral-500 mb-4 italic text-xl">Pronounced as "chia-how"</p>
      <p class="text-xl">I'm a software engineer, Elixir enthusiast, technical author, and an all around tech nerd!</p>
      <p class="text-xl">Right now, I'm interested in observability infrastructure and building emulators.</p>
      <p class="text-xl">Outside of tech, I'm very into bouldering, cooking, running, playing Dungeons &amp; Dragons, and watching musicals.</p>
      <div class="flex flex-row gap-2 items-center mt-4 mb-4">
        <!-- <p class="!mb-0 text-neutral-600">Catch me at:</p> -->
        <a href="https://woojiahao.com"><FaHouse size={24} className="text-neutral-400 hover:text-violet-500 transition duration-300" /></a>
        <a href="https://github.com/woojiahao"><FaGithub size={24} className="text-neutral-400 hover:text-black transition duration-300" /></a>
        <a href="https://linkedin.com/in/woojiahao"><FaLinkedin size={24} className="text-neutral-400 hover:text-blue-800 transition duration-300" /></a>
        <!-- <a href="https://x.com/woojiahao_"><FaXTwitter size={24} className="text-neutral-400 hover:text-black transition duration-300" /></a> -->
        <a href="mailto:woojiahao1234@gmail.com"><FaAt size={24} className="text-neutral-400 hover:text-orange-500 transition duration-300" /></a>
      </div>
      {latestShort != null && <ShortWidget short={latestShort} />}
    </div>
    <div class="w-[400px] h-[400px] rounded-md shadow-md lg:block hidden bg-[url(/profile.jpg)] bg-cover bg-position-[center_top]">
    </div>
  </div>

  <div>
    <div class="flex flex-row justify-between items-center mb-2">
      <div class="flex flex-row gap-8 items-center">
        <p class="text-3xl font-bold !mb-0">Latest articles</p>
        <a href="/articles" class="px-2 py-1 border-1 text-xs border-neutral-200 rounded-md hover:bg-neutral-50 text-neutral-600">View all</a>
      </div>
      <RssButton />
    </div>
    <HorizontalRuler />
    {
      latestArticles.map((article) => (
        <ArticleRow article={article} />
      ))
    }
    <div class="w-full flex flex-row justify-center mt-4">
      <a href="/articles" class="px-4 py-2 border-1 border-neutral-200 rounded-md hover:bg-neutral-50 text-neutral-600 font-bold">View all articles</a>
    </div>
  </div>
</Layout>
