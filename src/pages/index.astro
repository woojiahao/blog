---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { FaGithub, FaLinkedin, FaTwitter, FaAt, FaHouse, FaRss } from "react-icons/fa6";
import ArticleRow from '../components/ArticleRow.astro';

const latestArticles = (await getCollection("blog", ({data}) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 10)
---

<Layout>
  <div class="my-8 flex flex-row gap-36">
    <div class="flex-1/2">
      <h1 class="!mb-1">Hello, I'm Jiahao!</h1>
      <p class="text-neutral-500 mb-4 italic text-xl">Pronounced as "chia-how"</p>
      <p class="text-xl">I am a software engineer, Elixir enthusiast, technical author, and all around tech nerd!</p>
      <p class="text-xl">I am also a third-year Computer Science student at the National University of Singapore.</p>
      <p class="text-xl">Outside of tech, I am very into bouldering, cooking, running, and playing Dungeons &amp; Dragons.</p>
      <div class="flex flex-row gap-2 items-center mt-4">
        <p class="!mb-0 text-neutral-600">Catch me at:</p>
        <a href="https://woojiahao.com"><FaHouse size={24} className="text-neutral-400 hover:text-green-800 transition duration-300" /></a>
        <a href="https://github.com/woojiahao"><FaGithub size={24} className="text-neutral-400 hover:text-black transition duration-300" /></a>
        <a href="https://linkedin.com/in/woojiahao"><FaLinkedin size={24} className="text-neutral-400 hover:text-blue-800 transition duration-300" /></a>
        <a href="https://x.com/woojiahao_"><FaTwitter size={24} className="text-neutral-400 hover:text-sky-500 transition duration-300" /></a>
        <a href="mailto:woojiahao1234@gmail.com"><FaAt size={24} className="text-neutral-400 hover:text-orange-500 transition duration-300" /></a>
      </div>
    </div>
    <img class="w-[400px] h-[400px] rounded-md shadow-md" src="/profile.jpg"></img>
  </div>

  <div>
    <div class="flex flex-row justify-between items-center mb-2">
      <div class="flex flex-row gap-8 items-center">
        <p class="text-3xl font-bold !mb-0">Latest articles</p>
        <a href="/articles" class="px-2 py-1 border-1 text-xs border-neutral-200 rounded-md hover:bg-neutral-50 text-neutral-600">View all</a>
      </div>
      <p class="text-sm border-1 border-orange-200 px-3 py-1 rounded-full flex flex-row gap-2 items-center !mb-0 text-orange-500 transition duration-300 hover:cursor-pointer hover:bg-orange-50">Subscribe to my RSS feed<FaRss className="text-orange-500" /></p>
    </div>
    <div class="border-b-2 border-b-neutral-100 my-2 w-full" />
    {
      latestArticles.map((article) => (
        <ArticleRow article={article} />
      ))
    }
    <div class="w-full flex flex-row justify-center mt-4">
      <a href="/articles" class="px-4 py-2 border-1 border-neutral-200 rounded-md hover:bg-neutral-50 text-neutral-600 font-bold">View all articles</a>
    </div>
  </div>
</Layout>
