---
import "../styles/global.css"
import { SEO } from "astro-seo"
import { getImagePath } from "astro-opengraph-images"

const pageTitle = Astro.props.pageTitle || "jiahao.blog";

const description = Astro.props.description || "Personal blog of Jiahao!";
const { site } = Astro;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
    <title>jiahao.blog</title>
    <meta name="keywords"
      content="jiahao, jia hao, woo jia hao, woo, blog, software engineering, swe, singapore, student, nus, woojiahao, woo jiahao, woojia, ">
    <link rel="stylesheet" href="../styles/global.css" />

    <SEO
        title={pageTitle}
        description={description}
        openGraph={{
          basic: {
            type: "website",
            title: pageTitle,
            image: `${site}/ogImage.jpg`,
            url: site,
          },
          optional: {
            description: description,
          }
        }}
        twitter={{
          creator: "@woojiahao_"
        }}
        extend={{
          // extending the default link tags
          link: [{ rel: "icon", href: "/favicon.svg" }],
          // extending the default meta tags
          meta: [
            { name: "twitter:title", content: pageTitle },
            { name: "twitter:description", content: description },
          ],
        }}
      />
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L3DJGH6W78"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-L3DJGH6W78');
    </script>
	</head>
	<body class="min-h-lvh">
    <slot />
	</body>
</html>
