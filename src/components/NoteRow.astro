---
import type { getCollection } from "astro:content"
import { FaArrowUpRightFromSquare, FaStar } from "react-icons/fa6";

type NoteType = Awaited<ReturnType<typeof getCollection<"notes">>>[number]

const { note, hasContrast } = Astro.props as { note: NoteType, hasContrast: boolean }
---

<a href={note.data.url} class:list={[
  "flex flex-row justify-between items-center px-4 -mx-4 py-2 rounded-md hover:cursor-pointer transition duration-300 !no-underline",
  hasContrast ? "hover:bg-white" : "hover:bg-neutral-100 "
]}>
  <div class="flex flex-row gap-4 items-center">
    <FaStar className={note.data.pinned ? "text-yellow-300" : "text-neutral-200"} />
    <div class="flex flex-col">
      <p class="!text-black !text-lg !mb-0">{note.data.title}</p>
      {note.data.description && <p class="!text-neutral-400 !text-base !text-left !mb-0">{note.data.description}</p>}
    </div>
  </div>

  <FaArrowUpRightFromSquare className="text-neutral-500" />
</a>
